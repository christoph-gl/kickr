# ==============================================================================
# iamnotadoctor Configuration (OpenRouter)
# ==============================================================================
# Reference only. Create `.env.local` only with real values you want to enable.
# Do not commit `.env.local` — it is gitignored.

# Shared OpenRouter API key. Plain trainer control works without AI keys.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
# Default model used for chat, live coach, workout builder, and ride summaries
LLM_CALLS_MODEL=~google/gemini-flash-latest

# Multimodal model used for workout screenshot extraction
WORKOUT_IMAGE_EXTRACTOR_MODEL=~google/gemini-flash-latest

# Model used for Text-to-Speech (TTS) through OpenRouter-compatible audio.
GROK_TTS_MODEL=x-ai/grok-voice-tts-1.0
GROK_TTS_VOICE_ID=sal

# Optional per-lane overrides (leave commented out to use default model/key)
# LIVE_COACH_MODEL=google/gemini-2.5-flash
# LIVE_COACH_TIMEOUT_MS=8000
# FIXED_TRACK_COACH_TIMEOUT_MS=15000
# WORKOUT_BUILDER_MODEL=google/gemini-2.5-flash
# RIDE_SUMMARY_MODEL=google/gemini-2.5-flash

# Optional per-lane key overrides
# LLM_CALLS_API_KEY=
# WORKOUT_IMAGE_EXTRACTOR_API_KEY=
# LIVE_COACH_API_KEY=
# RIDE_SUMMARY_API_KEY=
# WORKOUT_BUILDER_API_KEY=
# MONTHLY_SUMMARY_API_KEY=
# GROK_TTS_API_KEY=
# GROK_TTS_TIMEOUT_MS=30000

# Hosted mode only. Leave unset for the local path (localhost only, no login).
# When set, every page and API route (including /api/mcp) requires this token:
# browsers sign in at /login, agents send `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32
# APP_AUTH_TOKEN=
