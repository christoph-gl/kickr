{
  "name": "iamnotadoctor",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:portless": "portless run next dev --turbopack",
    "dev:stop": "portless proxy stop || true",
    "dev:reset": "portless proxy stop || true && portless prune",
    "build": "next build",
    "start": "next start",
    "start:free": "PORT=0 next start",
    "build:start": "npm run build && npm run start:free",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-bluetooth": "^0.0.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "portless": "^0.15.4",
    "postcss": "^8.5.24",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
